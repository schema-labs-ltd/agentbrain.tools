{
  "name": "agentbrain",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Markdown context for AI agents, served through an OAuth-protected MCP server.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agentbrain-channel": "dist/channel/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/node/main.js",
    "dev": "tsx src/node/main.ts",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "channel": "tsx src/channel/main.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
