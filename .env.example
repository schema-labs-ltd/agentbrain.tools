# Public base URL agents connect to. Must be HTTPS for remote agents.
PUBLIC_URL=https://brain.example.com
# The single owner account used on the sign-in page.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me-to-something-long
